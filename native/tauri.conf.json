{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "VRoid Studio MCP",
	"version": "0.1.0",
	"identifier": "com.sandraschi.vroidstudio-mcp",
	"build": {
		"frontendDist": "../webapp/dist"
	},
	"app": {
		"windows": [
			{
				"label": "main",
				"title": "VRoid Studio MCP Operator",
				"width": 1280,
				"height": 860,
				"resizable": true
			}
		],
		"security": {
			"csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:10881 ipc: http://ipc.localhost; img-src 'self' data: http://127.0.0.1:10881; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
		}
	},
	"bundle": {
		"active": true,
		"targets": ["nsis"],
		"icon": ["icons/icon.png", "icons/icon.ico"],
		"resources": [
			"resources/vroidstudio-mcp-backend.exe",
            "resources/.env.example",
			],
		"windows": {
			"webviewInstallMode": {
				"type": "skip"
			},
			"nsis": {
				"installMode": "currentUser",
				"installerHooks": "./windows/hooks.nsh"
			}
		}
	},
	"plugins": {}
}







